{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nopilot Python project contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "runtime", "tasks"],
  "properties": {
    "schemaVersion": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "runtime": {"const": "python"},
    "install": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["requirements", "timeoutSeconds"], "properties": {"requirements": {"const": "requirements.txt"}, "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 600}}}]},
    "tasks": {"type": "object", "additionalProperties": false, "required": ["start"], "properties": {"start": {"$ref": "#/$defs/task"}, "check": {"$ref": "#/$defs/task"}}},
    "previewUrl": {"type": "string", "maxLength": 2000, "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/"}
  },
  "$defs": {"task": {"type": "object", "additionalProperties": false, "required": ["entrypoint", "args", "timeoutSeconds"], "properties": {"entrypoint": {"type": "string", "maxLength": 220, "pattern": "\\.py$"}, "args": {"type": "array", "maxItems": 30, "items": {"type": "string", "maxLength": 2000}}, "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 600}}}}
}
